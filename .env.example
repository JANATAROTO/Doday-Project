# Copy this file to `.env` (never commit `.env`) and fill in what you need.
# Every value is optional for local development except DJANGO_DEBUG.

# --- Django -----------------------------------------------------------------
# Local development only. In production leave it unset (DEBUG stays off).
DJANGO_DEBUG=True
# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Production: public domain or IP of the server, comma separated.
DJANGO_ALLOWED_HOSTS=
# Production over HTTPS: https://your-domain, comma separated.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to True once the site is served over HTTPS (secure cookies, HSTS, redirect).
DJANGO_HTTPS=
# Number of reverse proxies in front of Django (most hosting platforms: 1).
DJANGO_TRUSTED_PROXY_COUNT=0

# --- External services ------------------------------------------------------
# Google Maps JavaScript API (event map). Restrict the key to your site.
GOOGLE_MAPS_API_KEY=
# OpenRouteService (routes and address lookup).
ORS_API_KEY=
# Ticketmaster Discovery API (external event sync).
TICKETMASTER_API_KEY=
# Service area for accommodations: south,north,west,east.
ACCOMMODATION_ALLOWED_BOUNDS=6.10,6.40,-75.70,-75.45

# --- Email (password reset) -------------------------------------------------
# Without EMAIL_HOST, emails are printed to the server console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Doday <no-reply@example.com>
