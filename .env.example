# Copy this file to `.env` (never commit `.env`) and fill in what you need.
# Every value is optional for local development except DJANGO_DEBUG.
# In production these go in the hosting provider's environment settings.

# --- Django -----------------------------------------------------------------
# Local development only. In production leave it unset (DEBUG stays off).
DJANGO_DEBUG=True
# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Production: public domain(s) of the site, comma separated.
DJANGO_ALLOWED_HOSTS=
# Production over HTTPS: https://your-domain, comma separated.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to True once the site is served over HTTPS (secure cookies, HSTS, redirect).
DJANGO_HTTPS=
# How to read the visitor's real IP behind the hosting platform (rate limiting).
# Render and anything behind Cloudflare: CF-Connecting-IP
DJANGO_CLIENT_IP_HEADER=
# Alternative for other platforms: number of reverse proxies in front of Django.
DJANGO_TRUSTED_PROXY_COUNT=0

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string, e.g. from Neon:
#   postgresql://user:password@host/dbname?sslmode=require
# Empty = a local SQLite file (db.sqlite3), which is all development needs.
DATABASE_URL=

# --- Google Maps Platform (two keys, same Google Cloud project) --------------
# Browser key: draws the maps. Restrict it by website, to "Maps JavaScript API".
GOOGLE_MAPS_API_KEY=
# Server key: address lookup and routes. No website restriction; restrict it to
# "Geocoding API" and "Routes API". Never reuse the browser key here.
GOOGLE_MAPS_SERVER_KEY=
# Service area for accommodations: south,north,west,east.
ACCOMMODATION_ALLOWED_BOUNDS=6.10,6.40,-75.70,-75.45

# --- Optional services ------------------------------------------------------
# Ticketmaster Discovery API (import of external events).
TICKETMASTER_API_KEY=
# Sentry error reports.
SENTRY_DSN=

# --- Email (password reset) -------------------------------------------------
# Without EMAIL_HOST, emails are printed to the server console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Doday <no-reply@example.com>
